# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=bgp_mining
POSTGRES_USER=bgp
POSTGRES_PASSWORD=changeme

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Coleta ───────────────────────────────────────────────────────────────────
# Minuto(s) da hora em que a coleta é disparada (0–59)
# Um valor:   COLLECTION_MINUTE=7        → coleta às :07 de cada hora
# Múltiplos:  COLLECTION_MINUTE=7,37     → coleta às :07 e :37 de cada hora
COLLECTION_MINUTE=0,15,30,45

# Delay entre requisições HTTP (segundos) para respeitar rate limits
HTTP_DELAY_SECONDS=1

# Timeout para requisições HTTP (segundos)
HTTP_TIMEOUT_SECONDS=30

# Número máximo de tentativas com backoff exponencial
MAX_RETRIES=5

# ─── Logging ──────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
