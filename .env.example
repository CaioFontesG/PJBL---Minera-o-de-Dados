# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=bgp_mining
POSTGRES_USER=bgp
POSTGRES_PASSWORD=changeme

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Coleta ───────────────────────────────────────────────────────────────────
# Minuto da hora em que a coleta é disparada (0–59)
# Ex: 17 → coleta todo hora aos :17 (00:17, 01:17, 02:17...)
COLLECTION_MINUTE=07

# Delay entre requisições HTTP (segundos) para respeitar rate limits
HTTP_DELAY_SECONDS=1

# Timeout para requisições HTTP (segundos)
HTTP_TIMEOUT_SECONDS=30

# Número máximo de tentativas com backoff exponencial
MAX_RETRIES=5

# ─── Logging ──────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
